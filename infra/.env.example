# Copy to .env and fill in a NEW local SQL Server password.
# Keep each value single-quoted on one line (no embedded single quotes).
# Use 8-128 characters and at least 3 categories: upper/lowercase, digits, symbols.
# Empty placeholders intentionally prevent startup until configured.
MSSQL_SA_PASSWORD=''

# Optional: only needed if you explicitly choose to run CargarDatos.
# Use a disposable demo password, different from the SQL Server password.
DEMO_USER_PASSWORD=''
